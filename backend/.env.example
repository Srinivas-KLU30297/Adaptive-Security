# Email Delivery Settings (Optional)
# If you want email PDF delivery to work, enter your Gmail app password here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Database Settings
# By default, the backend connects to MySQL as root with your default password.
# If your friend's MySQL uses a different password, they MUST update it below and uncomment the line:
# DATABASE_URL=mysql+aiomysql://root:YOUR_FRIENDS_MYSQL_PASSWORD_HERE@localhost:3306/cybershield_db
